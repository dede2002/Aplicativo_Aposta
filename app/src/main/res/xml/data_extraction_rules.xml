<?xml version="1.0" encoding="utf-8"?><!--
   Regras de backup e transferência para Android 12+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- Token e Chat ID do bot do Telegram não saem do aparelho. O resto (apostas) continua no backup. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="telegram_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="telegram_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
