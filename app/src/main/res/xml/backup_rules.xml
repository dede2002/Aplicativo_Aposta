<?xml version="1.0" encoding="utf-8"?><!--
   Regras de backup para Android 11 e anteriores (no 12+ vale data_extraction_rules.xml).
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Token e Chat ID do bot do Telegram não saem do aparelho. O resto (apostas) continua no backup. -->
    <exclude domain="sharedpref" path="telegram_prefs.xml"/>
</full-backup-content>
