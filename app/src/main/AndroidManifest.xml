<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Avisar quando uma surebet do Telegram for importada (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Pedir para tirar o Tips da otimização de bateria (a importação em segundo plano não atrasa) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Importação disparada pelo push roda como serviço em primeiro plano no Android 11 ou mais antigo -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Apostas"
        tools:targetApi="31">

        <!-- Pede ao Google Play Services para baixar o modelo de OCR já na instalação -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <!-- Push do servidor do Tips (modo instantâneo) -->
        <service
            android:name=".telegram.PushTipsService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>


        <!-- Cadastro de aposta -->
        <activity android:name=".ui.CadastroApostaActivity" />

        <!-- Tela de Lucro -->
        <activity android:name=".ui.GraficoLucroAvancadoActivity" />

        <!-- Tela de depósito manual -->
        <activity android:name=".ui.DepositoManualActivity" />

        <!-- Tela de cadastrar aposta tigrinho -->
        <activity android:name=".ui.CadastroTigrinhoActivity" />

        <!-- Tela de cadastrar aposta tigrinho -->
        <activity android:name=".ui.CadastroSureActivity" />

        <!-- Tela para importar apostas do telegram -->
        <activity android:name=".ui.ImportacaoTelegramActivity" />

        <activity android:name=".ui.ContasActivity" />

        <!-- Tela principal -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Apostas">


            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
